# ── Database ────────────────────────────────────────────────────────────────
# Paste your MongoDB Atlas connection string here (without a database name —
# MONGODB_DB below selects it).
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="lumen_demo"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="30"

# ── App ─────────────────────────────────────────────────────────────────────
APP_ORIGIN="http://localhost:4001"
NODE_ENV="development"

# ── Preta ───────────────────────────────────────────────────────────────────
# Signs the context JWT that goes into the readable `preta_ctx` cookie. Generate
# a pair with the command below; keep the private half here and paste the public
# half into the Preta dashboard for this domain.
#
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=
#   generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},
#   privateKeyEncoding:{type:'pkcs8',format:'pem'}});require('fs').writeFileSync('lumen-public.pem',publicKey);
#   console.log(privateKey)"
#
# Without it the app runs normally — it just signs no token, so Preta sees an
# anonymous visitor and personalised elements never appear.
PRETA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
